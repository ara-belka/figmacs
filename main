<script>
document.addEventListener("DOMContentLoaded",()=>{
  const root=document.documentElement;
  const RMq=window.matchMedia("(prefers-reduced-motion: reduce)");
  const WIDEq=window.matchMedia("(min-width: 1081px)");
  const hasIO=("IntersectionObserver" in window);
  const RM=()=>RMq.matches;
  const WIDE=()=>WIDEq.matches;

  /* === ГЕЙТ progressive enhancement: js-класс только когда трюк безопасен === */
  const canEnhance=()=>WIDE()&&!RM()&&hasIO;
  const syncGate=()=>{ if(canEnhance()) root.classList.add("js"); else root.classList.remove("js"); };
  syncGate();
  WIDEq.addEventListener?.("change",syncGate);
  RMq.addEventListener?.("change",syncGate);

  /* reveal + line-mask (только под js; без js контент виден из CSS) */
  const revEls=document.querySelectorAll(".reveal,[data-mask]");
  if(root.classList.contains("js")){
    const ro=new IntersectionObserver((es)=>{es.forEach(e=>{if(e.isIntersecting){const d=e.target.dataset.revealDelay||0;e.target.style.transitionDelay=d+"ms";e.target.classList.add("is-visible","is-in");ro.unobserve(e.target);}});},{threshold:.15,rootMargin:"0px 0px -8% 0px"});
    revEls.forEach(el=>ro.observe(el));
  }else{revEls.forEach(el=>el.classList.add("is-visible","is-in"));}

  /* счётчики */
  const counters=document.querySelectorAll("[data-count]");
  const runCount=(el)=>{const t=Number(el.dataset.count||0),sfx=el.dataset.suffix||"",dur=RM()?0:1500,st=performance.now(),fmt=v=>Math.round(v).toLocaleString("ru-RU");
    const tick=(n)=>{const p=Math.min((n-st)/dur,1),e=1-Math.pow(1-p,3);el.textContent=fmt(t*e)+sfx;if(p<1)requestAnimationFrame(tick);};requestAnimationFrame(tick);};
  if(hasIO){const co=new IntersectionObserver((es)=>{es.forEach(e=>{if(e.isIntersecting){runCount(e.target);co.unobserve(e.target);}});},{threshold:.5});counters.forEach(c=>co.observe(c));}else{counters.forEach(runCount);}

  /* прогресс чтения */
  const prog=document.getElementById("progress");
  const onScroll=()=>{const h=document.documentElement,max=h.scrollHeight-h.clientHeight;prog.style.width=(max>0?(h.scrollTop/max)*100:0)+"%";};
  onScroll();window.addEventListener("scroll",onScroll,{passive:true});

  /* === SCROLLYTELLING: рост сети по шагам (только под js) === */
  const ORDER={c:0,comm:1,exp:2,pow:3,you:4};
  const graph=document.getElementById("graph");
  const scrolly=document.getElementById("scrolly");
  const steps=[...document.querySelectorAll(".step[data-step]")];
  let maxSeen=-1, so=null;
  const applyState=(i)=>{
    if(!graph)return;
    graph.querySelectorAll(".g-node").forEach(n=>{const o=ORDER[n.dataset.id];n.classList.toggle("on",o<=i);n.classList.toggle("hot",o===i&&i>0);});
    graph.querySelectorAll(".g-edge").forEach(p=>{const a=ORDER[p.dataset.f],b=ORDER[p.dataset.t];const on=a<=i&&b<=i;p.classList.toggle("on",on);p.classList.toggle("hot",on&&(a===i||b===i)&&i>0);});
    graph.querySelectorAll(".g-sub,.g-cap").forEach(t=>{const id=t.dataset.id;if(id){t.classList.toggle("on",ORDER[id]<=i);t.classList.toggle("hot",ORDER[id]===i&&i>0);}else{t.classList.add("on");}});
    if(scrolly){ if(i>=4) scrolly.classList.add("full"); else scrolly.classList.remove("full"); }
  };
  const startScrolly=()=>{
    if(!graph||!steps.length||so)return;
    maxSeen=-1;
    so=new IntersectionObserver((es)=>{es.forEach(e=>{if(e.isIntersecting){const i=Number(e.target.dataset.step||0);if(i>maxSeen){maxSeen=i;applyState(maxSeen);}}});},{rootMargin:"-45% 0px -45% 0px",threshold:0});
    steps.forEach(s=>so.observe(s));
    applyState(0);
  };
  const stopScrolly=()=>{ if(so){so.disconnect();so=null;} if(graph){graph.querySelectorAll(".g-node,.g-edge,.g-sub,.g-cap").forEach(n=>n.classList.remove("on","hot"));} if(scrolly)scrolly.classList.remove("full"); };
  const syncScrolly=()=>{ if(root.classList.contains("js")) startScrolly(); else stopScrolly(); };
  syncScrolly();
  WIDEq.addEventListener?.("change",syncScrolly);
  RMq.addEventListener?.("change",syncScrolly);

  /* федеральные чипы */
  const fed={
    partner:{title:"Найти партнёра в другом регионе",text:"Вы можете знакомиться с предпринимателями из других городов, обмениваться опытом, находить поставщиков, клиентов и совместные проекты не через холодный поиск, а через доверенную деловую сеть."},
    expert:{title:"Получить экспертизу не из своего города",text:"Через федеральную сеть можно быстро найти практика, который уже решал похожую задачу: выход на маркетплейсы, экспорт, производство, юридическая защита, привлечение инвестиций или кадровый вопрос."},
    visit:{title:"Организовать деловой визит или встречу",text:"Приезжать друг к другу на предприятия, проводить деловые завтраки, отраслевые встречи и переговоры в формате, где уже есть предварительное доверие и понятный контекст."},
    federal:{title:"Выйти на федеральные проекты и инициативы",text:"Региональное отделение — точка входа в общую повестку «ОПОРЫ РОССИИ»: рабочие группы, форумы, экспертные советы, защищённые инициативы и проекты по развитию предпринимательства."}
  };
  const chips=document.querySelectorAll(".chip"),fT=document.getElementById("federalTitle"),fX=document.getElementById("federalText");
  chips.forEach(c=>c.addEventListener("click",()=>{chips.forEach(i=>i.classList.remove("active"));c.classList.add("active");const k=c.dataset.key;if(fed[k]&&fT&&fX){fT.textContent=fed[k].title;fX.textContent=fed[k].text;}}));

  /* лента событий */
  const track=document.getElementById("eventTrack"),prev=document.getElementById("eventPrev"),next=document.getElementById("eventNext");
  const scrollEv=(dir)=>{if(!track)return;const a=track.clientWidth*.8;track.scrollBy({left:dir==="prev"?-a:a,behavior:RM()?"auto":"smooth"});};
  prev&&prev.addEventListener("click",()=>scrollEv("prev"));
  next&&next.addEventListener("click",()=>scrollEv("next"));

  /* табы + скользящий индикатор */
  const tabs=document.querySelectorAll(".tab"),panels=document.querySelectorAll(".panel"),ind=document.getElementById("tabInd");
  const placeInd=(tab)=>{if(!ind||!tab)return;ind.style.left=tab.offsetLeft+"px";ind.style.width=tab.offsetWidth+"px";};
  const activateTab=(tab)=>{tabs.forEach(i=>{i.classList.remove("active");i.setAttribute("aria-selected","false");});panels.forEach(p=>p.classList.remove("active"));tab.classList.add("active");tab.setAttribute("aria-selected","true");document.getElementById(tab.dataset.tab)?.classList.add("active");placeInd(tab);};
  tabs.forEach(tab=>tab.addEventListener("click",()=>activateTab(tab)));
  const initTab=document.querySelector(".tab.active");if(initTab)requestAnimationFrame(()=>placeInd(initTab));
  window.addEventListener("resize",()=>{placeInd(document.querySelector(".tab.active"));});

  /* форма */
  const form=document.getElementById("joinForm"),ok=document.getElementById("formSuccess");
  form&&form.addEventListener("submit",(e)=>{e.preventDefault();if(!form.checkValidity()){form.reportValidity();return;}ok.classList.add("show");form.reset();setTimeout(()=>ok.classList.remove("show"),7000);});
});
</script>
</body>
</html>
